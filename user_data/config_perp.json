{
  // ---------------------------------------------------------------------------
  // OKX USDT-margined perpetual swap config. Created 2026-07-28 (repair item 2).
  //
  // This file is the perp counterpart to config.json (spot). config.json is NOT
  // modified by this file's existence and remains the spot dry-run config.
  //
  // Every execution assumption here is explicit and must stay in agreement with
  // validator.COST_MODEL (user_data/research/validator.py). See
  // user_data/research/ARCHIVE_COST_NOTE.md and the "Execution and cost model"
  // section of PROJECT_OPERATOR_MANUAL.md.
  //
  // NOTE: freqtrade parses config JSON with comments allowed. Plain json.load()
  // will NOT read this file - use freqtrade.configuration.load_config_file, or
  // rapidjson with parse_mode=PM_COMMENTS|PM_TRAILING_COMMAS.
  // ---------------------------------------------------------------------------

  // 9 = the size of the pair_whitelist below, chosen so this key does NOT bind.
  // config.json uses 2, which against a 9-pair whitelist would silently cap every
  // portfolio test at 2 concurrent positions - a constraint that would shape
  // results without appearing anywhere in a report. Any real position limit is a
  // portfolio-construction decision and must be stated in the hypothesis, not
  // inherited by accident from an untouched config default.
  "max_open_trades": 9,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 5000,
  "cancel_open_orders_on_exit": false,

  "trading_mode": "futures",
  "margin_mode": "isolated",

  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },

  // Order types are declared here, not left to the strategy, so that live
  // execution matches COST_MODEL["fill_assumption"] = "taker". If the cost model
  // is ever switched to "maker_optimistic", these must change to "limit" AND the
  // maker-fill validation rule in PROJECT_OPERATOR_MANUAL.md applies.
  "order_types": {
    "entry": "market",
    "exit": "market",
    "emergency_exit": "market",
    "force_entry": "market",
    "force_exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },

  // price_side "other" (NOT config.json's "same"): a market order crosses the
  // book, so a long entry lifts the ask and a long exit hits the bid. freqtrade
  // enforces this pairing - it rejects market orders with price_side "same".
  // This is the same half-spread the harness charges via COST_MODEL["spread_bps"].
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },

  "exchange": {
    "name": "okx",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "_ft_has_params": {
      "ohlcv_candle_limit": 100
    },

    // ALL-IN PER-SIDE COST PROXY - NOT A LITERAL EXCHANGE FEE.
    //
    // 0.0009 = 9.0 bps/side = validator.per_side_cost("taker"), decomposed as:
    //     5.0 bps  OKX regular-tier (non-VIP) taker fee for USDT perps
    //   + 3.0 bps  slippage      (COST_MODEL["slippage_bps"], estimate)
    //   + 1.0 bps  half-spread   (COST_MODEL["spread_bps"] 2.0 / 2, estimate)
    //
    // The literal exchange taker fee is 0.0005. This key is deliberately set
    // HIGHER because freqtrade's "fee" is the only per-side cost lever it has:
    // the engine models no slippage and no bid-ask spread. Overloading it with
    // the all-in figure is what makes a freqtrade backtest on this config
    // comparable to a pandas-harness run, which charges all three components.
    //
    // Consequences, both of which must be respected:
    //   - Do NOT read fee_open / fee_close in a backtest result as exchange fees.
    //     They are all-in execution costs. Actual exchange fees are 5/9 of them.
    //   - If COST_MODEL's slippage_bps or spread_bps change, or fill_assumption
    //     switches to "maker_optimistic", this number MUST be recomputed from
    //     validator.per_side_cost(). It is not independent of that function.
    //
    // Without this key freqtrade falls back to its own default/exchange-fetched
    // value, which is what produced the 0.0015 fee_open/fee_close seen in every
    // archived backtest artifact (audit 2026-07-28 section 2F). No backtest may
    // run without this key set.
    "fee": 0.0009,

    // The 9 USDT perpetual instruments with complete cached data in
    // user_data/data/okx/futures/ (1d futures OHLCV, 1h futures OHLCV, 1h mark
    // price, 1h funding rate for each). Verified 2026-07-28.
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT",
      "SOL/USDT:USDT",
      "BNB/USDT:USDT",
      "XRP/USDT:USDT",
      "ADA/USDT:USDT",
      "AVAX/USDT:USDT",
      "DOT/USDT:USDT",
      "LINK/USDT:USDT"
    ],
    "pair_blacklist": []
  },

  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],

  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },

  // bot_name was "EmaRsiVolumeBot" in config.json - a stale label naming the very
  // first hypothesis ever tested (2026-05-14, rejected long ago). It is not tied
  // to any strategy here.
  "bot_name": "OkxPerpResearch",

  "initial_state": "running",
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5
  }
}
